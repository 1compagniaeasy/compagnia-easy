rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function activeMember() {
      return signedIn()
        && exists(/databases/$(database)/documents/members/$(request.auth.uid))
        && get(/databases/$(database)/documents/members/$(request.auth.uid)).data.active == true;
    }
    function admin() {
      return activeMember()
        && get(/databases/$(database)/documents/members/$(request.auth.uid)).data.role == 'admin';
    }

    match /members/{uid} {
      allow read: if admin() || (signedIn() && request.auth.uid == uid);
      // Solo un amministratore già autorizzato può creare/modificare/disattivare membri.
      allow create, update, delete: if admin();
    }

    match /announcements/{id} {
      allow read: if activeMember();
      allow create, update, delete: if admin();
    }

    match /events/{id} {
      allow read: if activeMember();
      allow create, update, delete: if admin();
    }

    match /attendance/{id} {
      allow read: if admin() || (activeMember() && resource.data.uid == request.auth.uid);
      allow create: if activeMember()
        && request.resource.data.uid == request.auth.uid;
      allow update, delete: if admin();
    }

    match /documents/{id} {
      allow read: if activeMember();
      allow create, update, delete: if admin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
