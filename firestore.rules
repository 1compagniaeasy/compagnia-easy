rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function hasMember(uid) { return exists(/databases/$(database)/documents/members/$(uid)); }
    function activeMember() {
      return signedIn() && hasMember(request.auth.uid)
        && get(/databases/$(database)/documents/members/$(request.auth.uid)).data.active == true;
    }
    function admin() {
      return activeMember()
        && get(/databases/$(database)/documents/members/$(request.auth.uid)).data.role == 'admin';
    }
    match /members/{uid} {
      // I membri attivi vedono i profili della squadra per nickname, presenze e compleanni.
      allow read: if activeMember();
      // Il membro modifica soltanto i propri dati anagrafici e nickname.
      allow update: if activeMember() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['firstName', 'lastName', 'nickname', 'birthDate', 'profileUpdatedAt']);
      allow create: if admin() || (signedIn()
        && request.auth.uid == uid
        && request.resource.data.email == request.auth.token.email
        && exists(/databases/$(database)/documents/invites/$(request.auth.token.email))
        && get(/databases/$(database)/documents/invites/$(request.auth.token.email)).data.email == request.auth.token.email
        && request.resource.data.role == get(/databases/$(database)/documents/invites/$(request.auth.token.email)).data.role);
      allow delete: if admin();
      allow update: if admin();
    }
    match /invites/{email} {
      allow read: if admin() || (signedIn() && request.auth.token.email == email);
      allow create, update, delete: if admin();
    }
    match /announcements/{id} {
      allow read: if activeMember();
      allow create, update, delete: if admin();
    }
    match /events/{id} {
      allow read: if activeMember();
      allow create, update, delete: if admin();
    }
    match /attendance/{id} {
      allow read: if activeMember();
      allow create: if activeMember() && request.resource.data.uid == request.auth.uid;
      allow update: if activeMember() && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        || admin();
      allow delete: if admin();
    }
    match /documents/{id} {
      allow read: if activeMember();
      allow create, update, delete: if admin();
    }
    match /{document=**} { allow read, write: if false; }
  }
}
